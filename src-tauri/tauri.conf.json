{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaylei",
  "version": "0.5.2",
  "identifier": "com.dmathlab.visualizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kaylei",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Discrete Mathematics DSL and visualizer",
    "category": "Education",
    "fileAssociations": [
      {
        "ext": [
          "dm"
        ],
        "name": "DMath program",
        "description": "Kaylei program",
        "role": "Editor"
      }
    ]
  }
}